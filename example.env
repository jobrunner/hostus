# Hostus Configuration
# Copy this file to .env and adjust values as needed.
#
# All keys are HOSTUS_-prefixed environment variables mapped from
# internal/config/config.go (viper, prefix HOSTUS_, "." -> "_"). There is
# no dotenv loader in the binary itself: these are plain process
# environment variables. Effective precedence is
# defaults < config.yaml < HOSTUS_* env vars < CLI flags.

# Server bind address (0.0.0.0 = all interfaces)
HOSTUS_SERVER_HOST=0.0.0.0

# Server port
HOSTUS_SERVER_PORT=8080

# Timeout for reading an incoming request
HOSTUS_SERVER_READ_TIMEOUT=30s

# Timeout for writing a response
HOSTUS_SERVER_WRITE_TIMEOUT=30s

# Log level: debug, info, warn, error
HOSTUS_LOGGING_LEVEL=info

# Log output format: json (structured) or text (human-readable)
HOSTUS_LOGGING_FORMAT=json

# Enable the Prometheus /metrics endpoint
HOSTUS_METRICS_ENABLED=true

# Allowed CORS origins (comma-separated, or * for all)
HOSTUS_CORS_ALLOWED_ORIGINS=*

# Enable TLS via CertMagic (automatic Let's Encrypt certificates)
HOSTUS_TLS_ENABLED=false

# Domains to request a certificate for (required if HOSTUS_TLS_ENABLED=true)
HOSTUS_TLS_DOMAINS=

# Contact email for the certificate authority (required if HOSTUS_TLS_ENABLED=true)
HOSTUS_TLS_EMAIL=

# Enable OpenTelemetry export (traces/metrics to a collector)
HOSTUS_TELEMETRY_ENABLED=false

# OTLP collector endpoint (host:port), required if HOSTUS_TELEMETRY_ENABLED=true
HOSTUS_TELEMETRY_ENDPOINT=

# Path to the local SQLite index/cache database file
HOSTUS_SQLITE_PATH=./data/hostus.db

# Maximum read connections for the serve path (default 4)
HOSTUS_SQLITE_MAX_READ_CONNS=4

# Serve the embedded test console at "/" (default: on).
# Set to false to expose the API only; "/" and all asset paths then 404.
HOSTUS_UI_ENABLED=true
