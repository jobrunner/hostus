{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jobrunner/hostus/schemas/dataset.schema.json",
  "title": "hostus dataset manifest",
  "description": "Fixed-name manifest (dataset.yaml) pinning every backbone/trait-vocabulary artifact ingested into hostus, per spec D.2 / 4.4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["backbones"],
  "properties": {
    "backbones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/backbone" }
    },
    "trait_vocabularies": {
      "type": "array",
      "items": { "$ref": "#/$defs/traitVocabulary" }
    },
    "xref_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/xrefSource" }
    }
  },
  "$defs": {
    "redistribution": {
      "type": "string",
      "enum": ["allowed", "restricted", "unknown"]
    },
    "backbone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "redistribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string" },
        "source": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "redistribution": { "$ref": "#/$defs/redistribution" }
      }
    },
    "traitVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "taxonomy", "license", "source", "path", "redistribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "taxonomy": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "redistribution": { "$ref": "#/$defs/redistribution" }
      }
    },
    "xrefSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license", "source", "path", "redistribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "redistribution": { "$ref": "#/$defs/redistribution" }
      }
    }
  }
}
